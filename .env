# Ambiente
NODE_ENV=development
PORT=3000

# Base de Datos MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=omada_payment

# Bancomercantil
# Obtener credenciales en https://developer.mercantilbanco.com
MERCANTIL_CONTROLLER_TYPE=sandbox
MERCANTIL_CLIENT_ID_SANDBOX=tu_client_id_sandbox
MERCANTIL_CLIENT_ID_PROD=tu_client_id_produccion
MERCANTIL_INTEGRATOR_ID=31
MERCANTIL_MERCHANT_ID=123456
MERCANTIL_TERMINAL_ID=abcde
MERCANTIL_ENCRYPTION_KEY=tu_clave_encriptacion

# Omada Cloud
OMADA_CONTROLLER_TYPE=cloud
OMADA_CLOUD_URL=https://cloud.omadanetwork.com
OMADA_SITE_ID=tu_site_id
OMADA_CLIENT_ID=tu_omada_client_id
OMADA_CLIENT_SECRET=tu_omada_client_secret
OMADA_USERNAME=admin@omada.com
OMADA_PASSWORD=tu_password_omada

# Omada OC200 (Hardware Controller)
OMADA_OC200_URL=https://192.168.1.1:8043
OMADA_OC200_SITE_ID=default
OMADA_OC200_USERNAME=admin
OMADA_OC200_PASSWORD=admin123
OMADA_OC200_VERIFY_SSL=false

# URLs
LANDING_URL=http://localhost:3000
CORS_ORIGIN=*

# Logging
LOG_LEVEL=debug