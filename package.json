{
  "name": "omada-captive-portal-payments",
  "version": "2.0.0",
  "description": "Portal Cautivo Omada con Pago Móvil Bancomercantil - Planes por Hora",
  "main": "backend/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "db:setup": "node scripts/setupDatabase.js",
    "db:seed": "mysql -u $DB_USER -p$DB_PASSWORD -h $DB_HOST $DB_NAME < database/seed.sql",
    "test": "jest --coverage",
    "lint": "eslint backend/",
    "format": "prettier --write backend/"
  },
  "keywords": [
    "omada",
    "captive-portal",
    "wifi",
    "bancomercantil",
    "payment",
    "mobile-payment"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.0",
    "axios": "^1.4.0",
    "crypto-js": "^4.1.1",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0",
    "validator": "^13.9.0",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "eslint": "^8.42.0",
    "prettier": "^2.8.8"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}